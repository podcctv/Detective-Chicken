{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detective-chicken:ip-quality-report:v1",
  "title": "Detective Chicken IP Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "agent_id", "node_id", "collected_at", "collector", "network", "quality"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_id": { "type": "string", "minLength": 10, "maxLength": 64 },
    "agent_id": { "type": "string", "minLength": 10 },
    "node_id": { "type": "string", "minLength": 10 },
    "collected_at": { "type": "string", "format": "date-time" },
    "collector": {
      "type": "object",
      "required": ["name", "adapter_version"],
      "properties": {
        "name": { "type": "string" },
        "adapter_version": { "type": "string" },
        "upstream_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "required": ["family", "reported_ip"],
      "properties": {
        "family": { "enum": [4, 6] },
        "reported_ip": { "type": "string" },
        "is_warp": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "asn": { "type": "integer" },
        "organization": { "type": "string" },
        "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
        "usage_type": { "type": "string" },
        "company_type": { "type": "string" },
        "ip_type": { "type": "string" },
        "scores": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
        "factors": { "type": "object", "additionalProperties": true },
        "media": { "type": "object", "additionalProperties": true },
        "mail": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "raw_upstream": {}
  }
}
